# WeatherLink API Configuration
# Get your API credentials at: https://www.weatherlink.com/account
# Documentation: https://weatherlink.github.io/v2-api/

# WeatherLink v2 API Key
REACT_APP_WEATHERLINK_API_KEY=your_api_key_here

# WeatherLink v2 API Secret
REACT_APP_WEATHERLINK_API_SECRET=your_api_secret_here

# Your Weather Station ID
REACT_APP_WEATHERLINK_STATION_ID=your_station_id_here
